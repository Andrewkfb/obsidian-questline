.vscode

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include generated plugin assets in the repo.
# They should be uploaded to GitHub releases instead.
# Anchored with a leading slash: a bare `styles.css` also matches
# src/styles.css, which is source and must be committed.
/main.js
/styles.css

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Logic-test build artifact
scripts/.logic-test.cjs
