{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2018",
		"moduleResolution": "node",
		"importHelpers": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"strict": true,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"lib": ["DOM", "ES5", "ES6", "ES7", "ES2018", "ES2021"]
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "scripts/**/*.ts"]
}
